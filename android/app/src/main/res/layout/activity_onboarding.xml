<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <!-- Logo area -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="🛡️"
        android:textSize="64sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/onboarding_title"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/onboarding_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.NFriend.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:backgroundTint="#1A1C1E"
        app:cardElevation="0dp"
        app:strokeColor="@color/primary_alpha"
        app:strokeWidth="1dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/onboarding_explanation"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Alias input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/alias_input_layout"
        style="@style/Widget.NFriend.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="@string/onboarding_alias_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/alias_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:maxLength="24"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Create button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_create_identity"
        style="@style/Widget.NFriend.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_create" />

    <!-- Loading state -->
    <ProgressBar
        android:id="@+id/onboarding_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/onboarding_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/onboarding_generating"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
